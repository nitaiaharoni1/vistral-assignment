{
  "name": "vistral-paperplay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint apps shared tests/setup tests/helpers vite.config.ts vitest.config.ts --deny-warnings",
    "format": "prettier --write apps shared tests/setup tests/helpers docs package.json tsconfig.json vite.config.ts vitest.config.ts .oxlintrc.json",
    "format:check": "prettier --check apps shared tests/setup tests/helpers docs package.json tsconfig.json vite.config.ts vitest.config.ts .oxlintrc.json",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "vitest run",
    "replay": "node tests/video-replay.mjs",
    "agent": "node --env-file-if-exists=.env.local --import tsx apps/backend/index.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
